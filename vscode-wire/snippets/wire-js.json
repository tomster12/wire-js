			"const ${1:name} = new Wire.Computed(\"${1}\", [${2:dep}], (${3:d}) => ${4:d});"
		],
		"description": "Declare a Wire.Computed signal"
	},
	"Wire: listen": {
		"prefix": "wire-listen",
		"body": [
			"const stop = ${1:signal}.listen((${2:value}) => {",
