{
	"name": "wire-js",
	"displayName": "Wire.js",
	"description": "HTML language support for Wire.js: <wire>/<component> attribute completion, on:, : and bind: attribute support, {{ }} and @{ } expression highlighting, @signal references, and snippets.",
	"version": "0.3.0",
	"publisher": "local",
	"license": "MIT",
	"engines": { "vscode": "^1.74.0" },
	"categories": ["Programming Languages", "Snippets"],
	"main": "./extension.js",
	"activationEvents": ["onLanguage:html"],
	"contributes": {
		"grammars": [
			{
				"scopeName": "wire.injection",
				"path": "./syntaxes/wire.injection.json",
				"injectTo": ["text.html.derivative", "text.html.basic"],
				"embeddedLanguages": {
					"meta.embedded.expression.wire": "javascript",
					"meta.embedded.expression.raw.wire": "javascript",
					"meta.embedded.attribute-expression.wire": "javascript"
				}
			}
		],
		"snippets": [
			{ "language": "html", "path": "./snippets/wire.json" },
			{ "language": "javascript", "path": "./snippets/wire-js.json" }
		],
		"html": {
			"customData": ["./html-data/wire.json"]
		}
	}
}
